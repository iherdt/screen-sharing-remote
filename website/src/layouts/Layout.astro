---
import "@fontsource-variable/inter";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Screen Sharing Remote — Control your Mac from your iPhone",
  description = "An iPhone client for Apple Screen Sharing. Taps land exactly where you touch, fast strokes never drop points, and your iPhone talks directly to your Mac. No account, no analytics.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0a1c" />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://screensharingremote.app/app-icon.png" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0e0a1c;
    --bg-2: #120e24;
    --card: #191330;
    --card-border: #2a2347;
    --text: #f3f1f9;
    --text-2: #bcb6d3;
    --text-3: #807a9c;
    --violet: #8b5cf6;
    --violet-deep: #6d28d9;
    --ice: #a5e0ff;
    --radius: 16px;
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: "Inter Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }
  a {
    color: var(--ice);
    text-decoration: none;
  }
</style>
